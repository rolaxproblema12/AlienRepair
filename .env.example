# Configura estos valores en `.env.local` (NO subir a git)
# Obtén los valores en https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sentry (opcional en dev; sin DSN, no se envía nada).
# El DSN del renderer se inyecta como VITE_*; el de main se inyecta vía
# build-time define en electron.vite.config.ts (process.env.SENTRY_DSN_MAIN).
VITE_SENTRY_DSN=
SENTRY_DSN_MAIN=

# Migration runner (scripts/migrate.ts). Connection string Postgres directa
# de Supabase: Project Settings > Database > Connection string > URI.
# Solo necesario para correr `npm run db:migrate`. NO commitear.
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# Playwright e2e (paso 10 del sprint). Apuntar a un proyecto Supabase
# DEDICADO de staging — nunca a producción. Ver playwright.config.ts.
E2E_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[STAGING_REF].supabase.co:5432/postgres
E2E_USER_EMAIL=qa@alientechnology.local
E2E_USER_PASSWORD=
E2E_SUCURSAL_ID=00000000-0000-0000-0000-000000000000
